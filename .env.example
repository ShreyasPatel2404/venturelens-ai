# ── VentureLens AI — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Google ADK / Gemini (needed from DAY 2) ───────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1          # or your nearest region

# ── Optional: Tavily / SerpAPI for web-search agent tool (DAY 3) ──────────────
TAVILY_API_KEY=
SERP_API_KEY=

# ── Optional: Supabase / Postgres (DAY 5+) ───────────────────────────────────
DATABASE_URL=

# ── Frontend (Vite reads VITE_ prefix) ───────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
